<mujoco model="panda spinning scene">
  <include file="models/robots/franka_emika_panda/scene.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
    <!-- Add some objects to interact with -->
    <body name="cube1" pos="0.3 0.3 0.1">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" rgba="1 0 0 1" mass="0.1"/>
    </body>
    
    <body name="cube2" pos="-0.3 0.3 0.1">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0 1 0 1" mass="0.1"/>
    </body>
    
    <body name="sphere" pos="0 0.4 0.1">
      <freejoint/>
      <geom type="sphere" size="0.03" rgba="0 0 1 1" mass="0.1"/>
    </body>
  </worldbody>
</mujoco>