<!-- ================================================================ -->
<!-- MUJOCO PANDA HANOI SCENE CONFIGURATION                          -->
<!-- ================================================================ -->
<!-- This file defines a complete Hanoi Tower solving scene with:     -->
<!-- - Franka Emika Panda robot arm with gripper                     -->
<!-- - Three posts (A, B, C) for the Tower of Hanoi puzzle          -->
<!-- - Three different-sized disks with collision geometry           -->
<!-- - IK target sites for precise manipulation                      -->
<!-- - Proper lighting and visual settings                           -->
<!-- ================================================================ -->

<mujoco model="niryo_hanoi_scene">

  <!-- ============================================================== -->
  <!-- GLOBAL SIMULATION SETTINGS                                    -->
  <!-- ============================================================== -->
  
      <compiler 
            angle="radian" 
            coordinate="local"
            meshdir="../../../models/robots/Arms/niryo_ned2/assets/ned2/stl" 
            autolimits="true"/>
  
  <option timestep="0.002" integrator="RK4" gravity="0 0 -8.0" 
          density="1.0" viscosity="1e-3" iterations="50" tolerance="1e-8">
    <flag warmstart="enable" energy="enable" fwdinv="enable"/>
  </option>
  
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.7 0.7 0.7"/>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048" offsamples="8"/>
  </visual>
  
  <!-- ============================================================== -->
  <!-- DEFAULT CLASSES AND STYLING                                   -->
  <!-- ============================================================== -->
  
  <default>
    <geom solimp="0.9 0.95 0.001" solref="0.02 1" condim="3" contype="1" conaffinity="1" friction="1.0 0.5 0.01"/>
    <joint armature="0.05" damping="5.0" frictionloss="0.05"/>
  </default>
  
  <!-- ============================================================== -->
  <!-- ASSETS: TEXTURES, MATERIALS, AND MESHES                       -->
  <!-- ============================================================== -->
  
  <asset>
    <!-- ===================== ENVIRONMENT ASSETS =================== -->
    <texture name="checker_floor" type="2d" builtin="checker" 
             rgb1="0.2 0.3 0.4" rgb2="0.8 0.9 1.0" width="128" height="128"/>
    <texture name="gradient_sky" type="skybox" builtin="gradient" 
             rgb1="0.4 0.6 0.8" rgb2="0.1 0.2 0.4" width="1024" height="1024" 
             mark="random" markrgb="1 1 1"/>
    <material name="floor_material" texture="checker_floor" texrepeat="8 8" reflectance="0.1"/>
    
    <!-- ===================== ROBOT MATERIALS ====================== -->
    <material name="robot_grey" rgba="0.356 0.361 0.376 1.0" specular="0.5" shininess="0.6"/>
    <material name="robot_blue" rgba="0.086 0.506 0.767 1.0" specular="0.5" shininess="0.6"/>
    <material name="robot_dark" rgba="0.15 0.15 0.15 1.0" specular="0.5" shininess="0.6"/>
    
    <!-- ==================== NIRYO ROBOT MESHES =================== -->
    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="shoulder_link" file="shoulder_link.stl"/>
    <mesh name="arm_link" file="arm_link.stl"/>
    <mesh name="elbow_link" file="elbow_link.stl"/>
    <mesh name="forearm_link" file="forearm_link.stl"/>
    <mesh name="wrist_link" file="wrist_link.stl"/>
    <mesh name="hand_link" file="hand_link.stl"/>
    <mesh name="base_gripper" file="base_gripper_1.STL"/>
    <mesh name="r_gripper_finger" file="mors_1.STL"/>
    <mesh name="l_gripper_finger" file="mors_2.STL"/>
    
  </asset>
  
  <!-- ============================================================== -->
  <!-- WORLD BODY: SCENE GEOMETRY AND OBJECTS                        -->
  <!-- ============================================================== -->
  
  <worldbody>
    <!-- ==================== LIGHTING SETUP ======================= -->
    <light name="top" pos="0 0 2" mode="trackcom"/>
    
    <!-- ======================= NIRYO ROBOT ======================= -->
    <!-- Niryo Robot with Position Control -->
    <body name="robot_base" pos="0 0 0">
      <geom pos="0 0 0" quat="0.707107 -0.707107 0 0" type="mesh" mesh="base_link" 
            material="robot_grey" mass="0.71142"/>
      
      <!-- Shoulder Joint -->
      <body name="shoulder_link" pos="0 0 0.1013">
        <inertial pos="-0.031951 0.0080419 0.030675" quat="0.500342 0.499382 0.516882 0.482813" 
                  mass="0.35056" diaginertia="0.000326411 0.000300927 0.000238682"/>
        <joint name="shoulder_joint" pos="0 0 0" axis="0 0 1" range="-3.14 3.14"/>
        <geom quat="0.707107 0 0 -0.707107" type="mesh" mesh="shoulder_link" material="robot_blue"/>
        
        <!-- Arm Joint -->
        <body name="arm_link" pos="0 0 0.065" quat="0.707107 0.707107 0 0">
          <inertial pos="-0.00096976 0.086432 0.0038832" quat="0.690493 0.722981 0.0220291 -0.00569833" 
                    mass="1.0838" diaginertia="0.00819788 0.00792912 0.0011765"/>
          <joint name="arm_joint" pos="0 0 0" axis="0 0 1" range="-1.8 0.6"/>
          <geom pos="0 0 0" quat="0 0 1 0" type="mesh" mesh="arm_link" material="robot_grey"/>
          
          <!-- Elbow Joint -->
          <body name="elbow_link" pos="0.012 0.221 0" quat="0.707107 0 0 0.707107">
            <inertial pos="-0.019703 0.037336 -1.7431e-09" quat="-0.0467018 0.705563 0.0467058 0.705563" 
                      mass="0.22126" diaginertia="0.00022753 0.000210147 0.000115903"/>
            <joint name="elbow_joint" pos="0 0 0" axis="0 0 1" range="-1.34 1.57"/>
            <geom quat="0 0.707107 0.707107 0" type="mesh" mesh="elbow_link" material="robot_blue"/>
            
            <!-- Forearm Joint -->
            <body name="forearm_link" pos="0.0325 -0.065 0" quat="0.707107 0.707107 0 0">
              <inertial pos="-0.0049532 7.8351e-06 0.08106" quat="0.705459 -0.041804 -0.0416797 0.706288" 
                        mass="0.35686" diaginertia="0.0014781 0.00138253 0.000221016"/>
              <joint name="forearm_joint" pos="0 0 0" axis="0 0 1" range="-2.09 2.09"/>
              <geom quat="0.707107 0 0 -0.707107" type="mesh" mesh="forearm_link" material="robot_blue"/>
              
              <!-- Wrist Joint -->
              <body name="wrist_link" pos="0 0 0.17" quat="0.707107 -0.707107 0 0">
                <inertial pos="-0.0162768 0.0351379 0" quat="0.618477 0.618477 0.342763 0.342763" 
                          mass="0.23495" diaginertia="0.00156403 0.00156324 0.00150233"/>
                <joint name="wrist_joint" pos="0 0 0" axis="0 0 1" range="-1.92 1.92"/>
                <geom quat="0.707107 0 0 -0.707107" type="mesh" mesh="wrist_link" material="robot_grey"/>
                
                <!-- Hand Joint -->
                <body name="hand_link" pos="0.00925 -0.0197 0" quat="0.707107 0.707107 0 0">
                  <inertial pos="-0.00051755 0.0029705 0.0115341" quat="0.418011 0.906052 0.0275832 0.0597875" 
                            mass="0.0080027" diaginertia="0.00150187 0.00150187 0.001501"/>
                  <joint name="hand_joint" pos="0 0 0" axis="0 0 1" range="-2.53 2.53"/>
                  <geom quat="0.707107 0 0 -0.707107" type="mesh" mesh="hand_link" material="robot_grey"/>
                  
                  <!-- Gripper Base -->
                  <body name="base_gripper" pos="-0.007 0 0.0315" quat="0.707107 -0.707107 0 0">
                    <geom type="mesh" mesh="base_gripper" material="robot_blue"/>
                  </body>
                  
                  <!-- Right Gripper Finger -->
                  <body name="r_gripper_finger" pos="0.00755 0.0096137 0.1111" quat="1 1.8366e-06 0 0">
                    <inertial pos="-0.0049739 0.0067393 -0.023929" quat="0.703927 0.0215488 -0.114093 0.700718" 
                              mass="0.067248" diaginertia="1.33992e-06 1.19147e-06 3.87144e-07"/>
                    <joint name="r_gripper_joint" pos="0 0 0" axis="0 1 0" type="slide" range="-0.01 0.01"/>
                    <geom name="r_gripper_finger_geom" type="mesh" mesh="r_gripper_finger" material="robot_dark" friction="1.5 1.0 0.01"/>
                  </body>
                  
                  <!-- Left Gripper Finger -->
                  <body name="l_gripper_finger" pos="0.00755 -0.011066 0.1111" quat="1 1.8366e-06 0 0">
                    <inertial pos="-0.0049739 -0.0067393 -0.023929" quat="0.700718 -0.114093 0.0215488 0.703927" 
                              mass="0.067248" diaginertia="1.33992e-06 1.19147e-06 3.87144e-07"/>
                    <joint name="l_gripper_joint" pos="0 0 0" axis="0 -1 0" type="slide" range="-0.01 0.01"/>
                    <geom name="l_gripper_finger_geom" type="mesh" mesh="l_gripper_finger" material="robot_dark" friction="1.5 1.0 0.01"/>
                  </body>
                  
                  <!-- End effector site -->
                  <site name="end_effector" pos="0 0 0.1" size="0.01" rgba="1 0 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
     
    <!-- =================== ENVIRONMENT OBJECTS =================== -->
    <!-- Floor surface -->
    <geom name="floor" pos="0 0 -0.05" size="2 2 0.05" type="box" material="floor_material"/>
    
    <!-- ================= HANOI TOWER POSTS ======================= -->
    <!-- Post A (Starting position - typically holds all disks) -->
            <body name="postA" pos="0.5 0 0.03">
                  <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
                  <geom name="post_blockA" type="box" size="0.005 0.005 0.05" rgba="0.2 0.2 0.2 1.0"/>
      <!-- IK target sites above post A at different heights (adjusted for box posts) -->
      <!-- box half-height = 0.03, body pos z = 0.03 => bottom = 0.0, top = 0.06 -->
      <site name="postA_base" pos="0 0 -0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 0 0 0.05"/>
      <site name="postA_level1" pos="0 0 -0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 0.3 0 0.05"/>
      <site name="postA_level2" pos="0 0 0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 0.6 0 0.05"/>
      <site name="postA_level3" pos="0 0 0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 0.9 0 0.05"/>
      <site name="postA_approach" pos="0 0 0.07" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 1 0 0.05"/>
    </body>
    
    <!-- Post B (Intermediate position) -->
            <body name="postB" pos="0.354 0.354 0.03">
                  <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
                  <geom name="post_blockB" type="box" size="0.005 0.005 0.05" rgba="0.2 0.2 0.2 1.0"/>
      <!-- IK target sites above post B at different heights (adjusted for box posts) -->
      <site name="postB_base" pos="0 0 -0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 1 0 0.05"/>
      <site name="postB_level1" pos="0 0 -0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="0.3 1 0 0.05"/>
      <site name="postB_level2" pos="0 0 0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="0.6 1 0 0.05"/>
      <site name="postB_level3" pos="0 0 0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="0.9 1 0 0.05"/>
      <site name="postB_approach" pos="0 0 0.07" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 1 1 0.05"/>
    </body>
    
    <!-- Post C (Final destination) -->
            <body name="postC" pos="0.354 -0.354 0.03">
                  <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
                  <geom name="post_blockC" type="box" size="0.005 0.005 0.05" rgba="0.2 0.2 0.2 1.0"/>
      <!-- IK target sites above post C at different heights (adjusted for box posts) -->
      <site name="postC_base" pos="0 0 -0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 0 1 0.05"/>
      <site name="postC_level1" pos="0 0 -0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 0.3 1 0.05"/>
      <site name="postC_level2" pos="0 0 0.01" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 0.6 1 0.05"/>
      <site name="postC_level3" pos="0 0 0.03" size="0.01 0.01 0.004" type="ellipsoid" rgba="0 0.9 1 0.05"/>
      <site name="postC_approach" pos="0 0 0.07" size="0.01 0.01 0.004" type="ellipsoid" rgba="1 0 1 0.05"/>
    </body>
    
    <!-- ==================== HANOI DISKS ========================== -->
    
    <!-- Disk 1 (Largest) - Red -->
    <body name="disk_body1" pos="0.5 0 0.05">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.02" diaginertia="0.0002 0.0002 0.0001"/>
      <!-- IK target sites for grasping disk 1 -->
      <site name="disk1_center" pos="0 0 0" size="0.0016" rgba="1 0.5 0.5 0.7"/>
      <!-- Collision geometry: approximated by 4 boxes (2 long + 2 short), mirrored to form a disk-like shape -->
      <geom name="disk1_sr" type="box" size="0.006 0.006 0.006" pos="0.006 0 0" rgba="0.8 0.2 0.2 1"
            density="5" friction="1.2 0.8 0.01"/>
      <geom name="disk1_sl" type="box" size="0.006 0.006 0.006" pos="-0.006 0 0" rgba="0.8 0.2 0.2 1"
            density="5" friction="1.2 0.8 0.01"/>
      <geom name="disk1_lt" type="box" size="0.018 0.006 0.006" pos="0 0.006 0" rgba="0.8 0.2 0.2 1"
            density="5" friction="1.2 0.8 0.01"/>
      <geom name="disk1_lb" type="box" size="0.018 0.006 0.006" pos="0 0.006 0" rgba="0.8 0.2 0.2 1"
            density="5" friction="1.2 0.8 0.01"/>      
    </body>
    
    <!-- ================== ADDITIONAL LIGHTING ==================== -->
    <light name="main_light" pos="0 0 3" ambient="0.3 0.3 0.3" diffuse="0.9 0.9 0.9" specular="0.5 0.5 0.5"/>
    <light name="side_light" pos="3 3 2" dir="-1 -1 -0.5" ambient="0.1 0.1 0.2" 
           diffuse="0.6 0.7 0.8" specular="0.2 0.2 0.3" directional="true"/>
  </worldbody>
  
  <!-- ============================================================== -->
  <!-- ACTUATORS: ROBOT JOINT CONTROL                                -->
  <!-- ============================================================== -->
  
  <actuator>
    <!-- Position actuators for Niryo robot joints -->
    <position name="shoulder_pos" joint="shoulder_joint" kp="500" kv="50" ctrlrange="-3.14 3.14"/>
    <position name="arm_pos" joint="arm_joint" kp="500" kv="50" ctrlrange="-1.8 0.6"/>
    <position name="elbow_pos" joint="elbow_joint" kp="400" kv="40" ctrlrange="-1.34 1.57"/>
    <position name="forearm_pos" joint="forearm_joint" kp="400" kv="40" ctrlrange="-2.09 2.09"/>
    <position name="wrist_pos" joint="wrist_joint" kp="300" kv="30" ctrlrange="-1.92 1.92"/>
    <position name="hand_pos" joint="hand_joint" kp="300" kv="30" ctrlrange="-2.53 2.53"/>
    <position name="r_gripper_pos" joint="r_gripper_joint" kp="200" kv="20" ctrlrange="-0.01 0.01"/>
    <position name="l_gripper_pos" joint="l_gripper_joint" kp="200" kv="20" ctrlrange="-0.01 0.01"/>
  </actuator>
  
  <!-- ============================================================== -->
  <!-- PREDEFINED KEYFRAMES                                          -->
  <!-- ============================================================== -->
  
  <keyframe>
    <key name="home" qpos="0 -0.5 1.0 0 0 0 0 0"/>
    <key name="ready" qpos="0 0 1.5 0 -1.5 0 0 0"/>
    <key name="reach" qpos="0 -1.2 1.8 0.5 -0.5 0 0 0"/>
    <key name="grip" qpos="0 -0.5 1.0 0 0 0 0.008 -0.008"/>
  </keyframe>

</mujoco>