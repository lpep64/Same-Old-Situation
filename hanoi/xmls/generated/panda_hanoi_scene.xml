      <site name="postB_level3" pos="0 0 0.05" size="0.05 0.05 0.02" type="ellipsoid" rgba="0.9 1 0 0.05"/>
      <site name="postB_approach" pos="0 0 0.20" size="0.05 0.05 0.02" type="ellipsoid" rgba="0 1 1 0.05"/>
    </body>
    
    <!-- Post C (Final destination) -->
    <body name="postC" pos="0.177 -0.177 0.15">
      <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
      <geom name="post_blockC" type="cylinder" size="0.01 0.15" rgba="0.2 0.2 0.2 1.0"/>
      <!-- IK target sites above post C at different heights -->
      <site name="postC_base" pos="0 0 -0.1" size="0.05 0.05 0.02" type="ellipsoid" rgba="0 0 1 0.05"/>
      <site name="postC_level1" pos="0 0 -0.05" size="0.05 0.05 0.02" type="ellipsoid" rgba="0 0.3 1 0.05"/>
      <site name="postC_level2" pos="0 0 0.0" size="0.05 0.05 0.02" type="ellipsoid" rgba="0 0.6 1 0.05"/>
