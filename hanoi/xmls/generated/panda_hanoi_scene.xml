      <freejoint/>
      <inertial pos="0 0 0" mass="0.25" diaginertia="0.005 0.005 0.005"/>
      <!-- Visual mesh for appearance (no collision) -->
      <geom name="disk_block2_visual" type="mesh" mesh="donut_mesh2" rgba="0.2 0.8 0.2 1" 
