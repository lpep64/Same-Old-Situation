    <!-- =================== ENVIRONMENT OBJECTS =================== -->
    <!-- Floor surface -->
    <geom name="floor" pos="0 0 -0.05" size="2 2 0.05" type="box" material="floor_material"/>
    
    <!-- ================= HANOI TOWER POSTS ======================= -->
    <!-- Post A (Starting position - typically holds all disks) -->
    <body name="postA" pos="0.25 0 0.15">
      <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
      <geom name="post_blockA" type="cylinder" size="0.01 0.15" rgba="0.2 0.2 0.2 1.0"/>
      <!-- IK target sites above post A at different heights -->
      <site name="postA_base" pos="0 0 -0.10" size="0.05 0.05 0.02" type="ellipsoid" rgba="1 0 0 0.05"/>
      <site name="postA_level1" pos="0 0 -0.05" size="0.05 0.05 0.02" type="ellipsoid" rgba="1 0.3 0 0.05"/>
      <site name="postA_level2" pos="0 0 0.0" size="0.05 0.05 0.02" type="ellipsoid" rgba="1 0.6 0 0.05"/>
      <site name="postA_level3" pos="0 0 0.05" size="0.05 0.05 0.02" type="ellipsoid" rgba="1 0.9 0 0.05"/>
      <site name="postA_approach" pos="0 0 0.20" size="0.05 0.05 0.02" type="ellipsoid" rgba="1 1 0 0.05"/>
    </body>
    
    <!-- Post B (Intermediate position) -->
    <body name="postB" pos="0.177 0.177 0.15">
      <inertial pos="0 0 0" mass="3" diaginertia="0.005 0.005 0.005"/>
      <geom name="post_blockB" type="cylinder" size="0.01 0.15" rgba="0.2 0.2 0.2 1.0"/>
