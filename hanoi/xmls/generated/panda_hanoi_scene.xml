    <!-- ==================== HANOI DISKS ========================== -->
    
    <!-- Disk 1 (Largest) - Red -->
    <body name="disk_body1" pos="0.354 0.354 0.05">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.25" diaginertia="0.005 0.005 0.005"/>
