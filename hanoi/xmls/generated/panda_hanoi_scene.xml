<!-- ================================================================ -->
<!-- MUJOCO PANDA HANOI SCENE CONFIGURATION                          -->
<!-- ================================================================ -->
<!-- This file defines a complete Hanoi Tower solving scene with:     -->
<!-- - Franka Emika Panda robot arm with gripper                     -->
<!-- - Three posts (A, B, C) for the Tower of Hanoi puzzle          -->
<!-- - Three different-sized disks with collision geometry           -->
<!-- - IK target sites for precise manipulation                      -->
<!-- - Proper lighting and visual settings                           -->
<!-- ================================================================ -->

<mujoco model="panda_hanoi_scene">

  <!-- ============================================================== -->
  <!-- GLOBAL SIMULATION SETTINGS                                    -->
  <!-- ============================================================== -->
  
  <compiler 
    angle="radian" 
    meshdir="../../../models/robots/arms/franka_emika_panda/assets" 
    autolimits="true"/>
  
  <option timestep="0.002" integrator="RK4" gravity="0 0 -3.0" 
          density="1.0" viscosity="1e-4">
    <flag warmstart="enable"/>
  </option>
  
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.7 0.7 0.7"/>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048" offsamples="8"/>
  </visual>
  
  <!-- ============================================================== -->
  <!-- DEFAULT CLASSES AND STYLING                                   -->
  <!-- ============================================================== -->
  
  <default>
    <!-- Main Panda robot defaults -->
    <default class="panda">
      <material specular="0.5" shininess="0.25" />
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973" />
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87" />
      
      <!-- Gripper finger defaults -->
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04" />
      </default>
      
      <!-- Visual geometry defaults -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      
      <!-- Collision geometry defaults -->
      <default class="collision">
        <geom type="mesh" group="3" />
        <!-- Fingertip collision geometries for precise grasping -->
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445" material="gripper" />
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05" material="gripper" />
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05" material="gripper" />
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395" material="gripper" />
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395" material="gripper" />
        </default>
      </default>
    </default>
  </default>
  
  <!-- ============================================================== -->
  <!-- ASSETS: TEXTURES, MATERIALS, AND MESHES                       -->
  <!-- ============================================================== -->
  
  <asset>
    <!-- ===================== ENVIRONMENT ASSETS =================== -->
    <texture name="checker_floor" type="2d" builtin="checker" 
             rgb1="0.2 0.3 0.4" rgb2="0.8 0.9 1.0" width="128" height="128"/>
    <texture name="gradient_sky" type="skybox" builtin="gradient" 
             rgb1="0.4 0.6 0.8" rgb2="0.1 0.2 0.4" width="1024" height="1024" 
             mark="random" markrgb="1 1 1"/>
    <material name="floor_material" texture="checker_floor" texrepeat="8 8" reflectance="0.1"/>
    
    <!-- ===================== ROBOT MATERIALS ====================== -->
    <material class="panda" name="white" rgba="1 1 1 1"/>
    <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
    <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>
    <material class="panda" name="green" rgba="0 1 0 1"/>
    <material class="panda" name="gripper" rgba="0.8 0.8 0.8 1"/>
    <material class="panda" name="light_blue" rgba="0.039216 0.541176 0.780392 1"/>
    
    <!-- ================= ROBOT COLLISION MESHES ================== -->
    <!-- Collision meshes for physics simulation -->
    <mesh name="link0_c" file="link0.stl"/>
    <mesh name="link1_c" file="link1.stl"/>
    <mesh name="link2_c" file="link2.stl"/>
    <mesh name="link3_c" file="link3.stl"/>
    <mesh name="link4_c" file="link4.stl"/>
