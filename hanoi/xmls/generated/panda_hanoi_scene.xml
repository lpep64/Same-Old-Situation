    <mesh file="link0_10.obj"/>
    <mesh file="link0_11.obj"/>
    
    <!-- Link 1 visual mesh -->
    <mesh file="link1.obj"/>
    
    <!-- Link 2 visual mesh -->
    <mesh file="link2.obj"/>
    
    <!-- Link 3 visual meshes -->
    <mesh file="link3_0.obj"/>
