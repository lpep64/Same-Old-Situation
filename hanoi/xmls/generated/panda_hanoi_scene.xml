    <mesh scale="0.4 0.4 0.5" name="donut_mesh1" file="../../../../../hanoi/models/hanoi_disk.stl"/>
    <mesh scale="0.375 0.375 0.5" name="donut_mesh2" file="../../../../../hanoi/models/hanoi_disk.stl"/>
    <mesh scale="0.35 0.35 0.5" name="donut_mesh3" file="../../../../../hanoi/models/hanoi_disk.stl"/>
  </asset>
  
  <!-- ============================================================== -->
  <!-- WORLD BODY: SCENE GEOMETRY AND OBJECTS                        -->
  <!-- ============================================================== -->
  
