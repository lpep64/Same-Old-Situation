<mujoco model="ned2">
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ned2">
      <joint armature="0.1" damping="1"/>
      <position inheritrange="1"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material name="black" rgba=".2 .2 .2 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="red" rgba="1 0.072272 0.039546 1"/>
    <material name="gray" rgba="0.863156 0.863156 0.863157 1"/>
    <material name="blue" rgba="0.024157 0.445201 0.737911 1"/>
    <material name="yellow" rgba="0.7 0.7 0 1"/>

    <!-- Visual meshes -->
    <mesh name="base_visual" file="1- BASE - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="shoulder_visual" file="2- SHOULDER - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="arm_visual" file="3- ARM - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="elbow_visual" file="4- ELBOW - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="forearm_visual" file="5- FOREARM - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="wrist_visual" file="6- WRIST - V1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hand_visual" file="7- HAND - V1.obj" scale="0.001 0.001 0.001"/>

    <!-- Collision meshes -->
    <mesh name="base_coll" file="1- BASE - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="shoulder_coll" file="2- SHOULDER - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_coll" file="3- ARM - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="elbow_coll" file="4- ELBOW - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="forearm_coll" file="5- FOREARM - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="wrist_coll" file="6- WRIST - V1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hand_coll" file="7- HAND - V1.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="base" childclass="ned2">
      <body name="base_link">
        <geom mesh="base_visual" material="gray" class="visual"/>
        <geom name="base_link_collision" mesh="base_coll" class="collision"/>
        <inertial pos="-0.008924 0.0001357 0.052392" mass="0.71142" 
                  diaginertia="0.0017 0.0017 0.0032"/>
        
        <body name="shoulder_link" pos="0 0 0.1013">
          <inertial pos="-0.031951 0.0080419 0.030675" mass="0.35056" 
                    diaginertia="0.00023875 0.00032638 0.00030089"/>
          <joint name="ned2_joint1" axis="0 0 1" range="-3.05433 3.05433"/>
          <geom name="shoulder_link_collision" class="collision" mesh="shoulder_coll"/>
          <geom material="blue" mesh="shoulder_visual" class="visual"/>
          
          <body name="arm_link" pos="0 0 0.065" quat="0.707107 0.707107 0 0">
            <inertial pos="-0.00096976 0.086432 0.0038832" quat="0 0 1 0" mass="1.0838" 
                      diaginertia="0.008194 0.0011945 0.007915"/>
            <joint name="ned2_joint2" axis="0 0 1" range="-1.91986 0.640187"/>
            <geom material="white" mesh="arm_visual" class="visual" quat="0 0 1 0"/>
            <geom name="arm_link_collision" class="collision" mesh="arm_coll" quat="0 0 1 0"/>
            
            <body name="elbow_link" pos="0.012 0.221 0" quat="0.707107 0 0 0.707107">
              <inertial pos="-0.019703 0.037336 0" quat="0 0 1 0" mass="0.22126" 
                        diaginertia="0.00011754 0.00020851 0.00022753"/>
              <joint name="ned2_joint3" axis="0 0 1" range="-1.39626 1.39626"/>
              <geom mesh="elbow_visual" material="yellow" class="visual" quat="0.5 0.5 -0.5 0.5"/>
              <geom name="elbow_link_collision" class="collision" mesh="elbow_coll" quat="0.5 0.5 -0.5 0.5"/>
              
              <body name="forearm_link" pos="0.0325 -0.065 0" quat="0.707107 0.707107 0 0">
                <inertial pos="-0.0049532 7.8351E-06 0.08106" mass="0.35686" 
                          diaginertia="0.0013664 0.0014781 0.00023715"/>
                <joint name="ned2_joint4" axis="0 0 1" range="-3.05433 3.05433"/>
                <geom mesh="forearm_visual" material="red" class="visual" quat="0 0 -0.707107 0.707107"/>
                <geom name="forearm_link_collision" class="collision" mesh="forearm_coll" quat="0 0 -0.707107 0.707107"/>
                
                <body name="wrist_link" pos="0 0 0.17" quat="0.707107 -0.707107 0 0">
                  <inertial pos="-0.019666 0.037312 0.0" mass="0.22126" 
                            diaginertia="0.0015 0.0015 0.0015"/>
                  <joint name="ned2_joint5" axis="0 0 1" range="-1.74533 1.74533"/>
                  <geom mesh="wrist_visual" material="black" class="visual" quat="0 0 -0.707107 0.707107"/>
                  <geom name="wrist_link_collision" class="collision" mesh="wrist_coll" quat="0 0 -0.707107 0.707107"/>
                  
                  <body name="hand_link" pos="0.00925 -0.0197 0" quat="0.707107 0.707107 0 0">
                    <inertial pos="0 0 0.009" mass="0.0070027" 
                              diaginertia="0.0015 0.0015 0.0015"/>
                    <joint name="ned2_joint6" axis="0 0 1" range="-3.05433 3.05433"/>
                    <geom mesh="hand_visual" material="gray" class="visual" quat="0 0 -0.707107 0.707107"/>
                    <geom name="hand_link_collision" class="collision" mesh="hand_coll" quat="0 0 -0.707107 0.707107"/>
                    
                    <body name="tool_link" pos="0 0 0.02" quat="0.5 -0.5 0.5 0.5">
                      <site name="attachment_site" pos="0 0 0"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="ned2" name="ned2_joint1" joint="ned2_joint1" kp="4500" kv="450"/>
    <position class="ned2" name="ned2_joint2" joint="ned2_joint2" kp="4500" kv="450"/>
    <position class="ned2" name="ned2_joint3" joint="ned2_joint3" kp="3500" kv="350"/>
    <position class="ned2" name="ned2_joint4" joint="ned2_joint4" kp="3500" kv="350"/>
    <position class="ned2" name="ned2_joint5" joint="ned2_joint5" kp="2000" kv="200"/>
    <position class="ned2" name="ned2_joint6" joint="ned2_joint6" kp="2000" kv="200"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>